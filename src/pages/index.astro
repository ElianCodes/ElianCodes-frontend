---
import { getCollection } from "astro:content";

// Phase 1 placeholder: proves content collections load and the deploy pipeline works.
// The V5 "Signal" design replaces this page in phase 3.
const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const events = await getCollection("events");
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>elian.codes · rebuild in progress</title>
	</head>
	<body>
		<main>
			<h1>elian.codes</h1>
			<p>Rebuild in progress: Astro, Vite+ and Void on Cloudflare.</p>
			<p>{posts.length} articles · {events.length} events loaded</p>
			<ul>
				{posts.slice(0, 5).map((post) => <li>{post.data.title}</li>)}
			</ul>
		</main>
	</body>
</html>
