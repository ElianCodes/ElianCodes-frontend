---
import BaseHead, { type Props as HeadProps } from "../components/layout/BaseHead.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import Ticker from "../components/layout/Ticker.astro";
import "../styles/global.css";

export type Props = HeadProps;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead {...Astro.props} />
		<slot name="head" />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<Ticker />
		<SiteHeader />
		<main id="main">
			<slot />
		</main>
		<SiteFooter />
		<p class="weird-toast mono" role="status" aria-live="polite" data-weird-toast></p>
		<script>
			import "../scripts/webmcp";
		</script>
		<script>
			// Easter egg: the Konami code makes the web weird again. Press it again to undo.
			const code = ["ArrowUp", "ArrowUp", "ArrowDown", "ArrowDown", "ArrowLeft", "ArrowRight", "ArrowLeft", "ArrowRight", "b", "a"];
			let progress = 0;
			const toast = document.querySelector<HTMLElement>("[data-weird-toast]");
			document.addEventListener("keydown", (event) => {
				progress = event.key === code[progress] ? progress + 1 : event.key === code[0] ? 1 : 0;
				if (progress < code.length) return;
				progress = 0;
				const on = document.documentElement.classList.toggle("weird");
				if (toast) {
					toast.textContent = on ? "Weird mode on. The web is weird again." : "Back to normal. Boring.";
					toast.classList.add("weird-toast--show");
					setTimeout(() => toast.classList.remove("weird-toast--show"), 2600);
				}
			});
			console.log(
				"%c> whoami%c\nCurious? The source is on GitHub: https://github.com/ElianCodes/ElianCodes-frontend\nAlso try the Konami code.",
				"color:#ff48b0;font:700 16px monospace",
				"font:12px monospace",
			);
		</script>
	</body>
</html>
