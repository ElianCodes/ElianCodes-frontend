---
import { Font } from "astro:assets";
import { site } from "../../data/site";

export interface Props {
	title?: string;
	description?: string;
	socialImg?: URL | string;
	socialImgAlt?: string;
	pageType?: "website" | "article" | "profile";
	publishedTime?: string;
	modifiedTime?: string;
	noindex?: boolean;
	schema?: Record<string, unknown> | Array<Record<string, unknown>>;
	/** Raw-markdown twin of this page, advertised for agents and LLMs. */
	markdownAlternate?: string;
}

const {
	title,
	description = site.description,
	socialImg = new URL("/assets/img/social.jpg", Astro.site),
	socialImgAlt,
	pageType = "website",
	publishedTime,
	modifiedTime,
	noindex = false,
	schema,
	markdownAlternate,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteUrl = new URL("/", Astro.site);
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const imageUrl = new URL(socialImg, Astro.site);
const imageAlt = socialImgAlt ?? `${fullTitle} social preview image`;
const robots = noindex
	? "noindex, nofollow"
	: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

// Analytics stay off until the domain moves over; set ENABLE_ANALYTICS=true at build time to turn them on.
const gaId = "G-13MBMB5GZJ";
const analyticsEnabled = import.meta.env.ENABLE_ANALYTICS === "true";

const siteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: site.name,
	url: siteUrl.toString(),
	description,
	inLanguage: "en",
	publisher: {
		"@type": "Person",
		"@id": `${siteUrl}#person`,
		name: site.author,
		url: siteUrl.toString(),
		sameAs: [
			"https://github.com/ElianCodes",
			"https://www.linkedin.com/in/elianvancutsem",
			"https://bsky.app/profile/elian.codes",
			"https://x.com/eliancodes",
		],
	},
};
const schemaList = Array.isArray(schema) ? schema : schema ? [schema] : [];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={site.author} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalURL} />

<Font cssVariable="--font-display" preload />
<Font cssVariable="--font-mono" preload />
<Font cssVariable="--font-body" preload />

<link rel="alternate" href="/blog.xml" type="application/rss+xml" title="Elian Codes · Articles" />
<link rel="alternate" href="/llms.txt" type="text/plain" />
{markdownAlternate && <link rel="alternate" href={markdownAlternate} type="text/markdown" />}

<meta property="og:type" content={pageType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@eliancodes" />
<meta name="twitter:creator" content="@eliancodes" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-icon-180x180.png" />
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#0078BF" />
<meta name="format-detection" content="telephone=no" />

<script is:inline type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
{
	schemaList.map((entry) => (
		<script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />
	))
}

{
	analyticsEnabled && (
		<Fragment>
			<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
			<script is:inline define:vars={{ gaId }}>
				window.dataLayer = window.dataLayer || [];
				function gtag() {
					dataLayer.push(arguments);
				}
				gtag("js", new Date());
				gtag("config", gaId);
			</script>
		</Fragment>
	)
}
