---
/**
 * Photo in the V5 "Signal" treatment: a blue-shadow / pink-highlight duotone applied in CSS,
 * so originals stay full colour on disk. Hover (or focus within a link) reveals the original.
 * Pass `treated={false}` for images that already have the look baked in.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

export interface Props {
	src: ImageMetadata;
	alt: string;
	widths?: number[];
	sizes?: string;
	position?: string;
	treated?: boolean;
	loading?: "eager" | "lazy";
	class?: string;
}

const {
	src,
	alt,
	widths = [480, 800, 1200, 1600],
	sizes = "100vw",
	position = "center",
	treated = true,
	loading = "lazy",
	class: className,
} = Astro.props;
---

<span class:list={["photo", { "photo--treated": treated }, className]}>
	<Image
		src={src}
		alt={alt}
		widths={widths.filter((w) => w <= src.width)}
		sizes={sizes}
		loading={loading}
		style={`object-position: ${position}`}
	/>
</span>

<style>
	.photo {
		position: relative;
		display: block;
		overflow: hidden;
		background: var(--pink);
	}

	.photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.photo--treated img {
		filter: grayscale(1) contrast(1.15) brightness(1.08);
		mix-blend-mode: multiply;
		transition: filter 0.4s ease;
	}

	.photo--treated::after {
		content: "";
		position: absolute;
		inset: 0;
		background: var(--blue);
		mix-blend-mode: lighten;
		pointer-events: none;
		transition: opacity 0.4s ease;
	}

	:global(a:hover) > .photo--treated::after,
	:global(a:focus-visible) > .photo--treated::after,
	.photo--treated:hover::after {
		opacity: 0;
	}

	:global(a:hover) > .photo--treated img,
	:global(a:focus-visible) > .photo--treated img,
	.photo--treated:hover img {
		filter: none;
		mix-blend-mode: normal;
	}
</style>
